# Content-hashed build assets (index-<hash>.js, etc.) never change for a given
# hash — cache them hard and never revalidate.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The entry document must always be revalidated so it points at the latest
# asset hashes after a deploy. Never let a browser run a stale index.html.
/index.html
  Cache-Control: no-cache
/
  Cache-Control: no-cache
